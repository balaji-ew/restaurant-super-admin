# Backend origin — no version segment, no trailing slash. The `/v1` prefix is
# appended in config/api.config.ts.
#
# On the dev tunnel so the console can be driven from another machine. Swap
# back to http://localhost:8080 to work fully offline; the tunnel must be up
# or every screen loads empty.
NEXT_PUBLIC_API_BASE_URL=https://khshzjmt-8080.inc1.devtunnels.ms

# NextAuth
NEXTAUTH_SECRET=bb-admin-local-dev-secret
