# Backend origin only — no version segment, no trailing slash.
# The `/v1` prefix is appended in config/api.config.ts.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# NextAuth. Generate a real secret for anything but local dev:
#   openssl rand -base64 32
NEXTAUTH_SECRET=change-me
NEXTAUTH_URL=http://localhost:3001
NEXT_PUBLIC_BASE_PATH=http://localhost:3001
